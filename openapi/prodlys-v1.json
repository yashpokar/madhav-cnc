      "get": {
        "tags": [
          "Account"
        ],
        "summary": "The signed-in person and the companies they may open",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "email": {
                              "type": "string"
                            },
                            "image": {
                              "nullable": true,
                              "type": "string"
                            },
                            "globalRole": {
                              "type": "string",
                              "enum": [
                                "ADMIN",
                                "SALES",
                                "OPERATOR",
                                "DISPATCH",
                                "ACCOUNTANT",
                                "VIEWER"
                              ]
                            },
                            "isSuperAdmin": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "email",
                            "image",
                            "globalRole",
                            "isSuperAdmin"
                          ],
                          "additionalProperties": false
                        },
                        "companies": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "role": {
                                "type": "string",
                                "enum": [
                                  "ADMIN",
                                  "SALES",
                                  "OPERATOR",
                                  "DISPATCH",
                                  "ACCOUNTANT",
                                  "VIEWER"
                                ]
                              },
                              "capabilities": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "industry": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "id",
                              "name",
                              "role",
                              "capabilities",
                              "industry"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "user",
                        "companies"
                      ],
                      "additionalProperties": false
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED: Missing, invalid or expired bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_DEACTIVATED: The account has been deactivated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
