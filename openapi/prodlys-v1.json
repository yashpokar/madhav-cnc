                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL: Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "delete": {
        "tags": [
          "Account"
        ],
        "summary": "Delete the account (anonymises it; refused with 409 for the last administrator of a company with other members)",
        "security": [
