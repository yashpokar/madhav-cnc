    "/openapi.json": {
      "get": {
        "tags": [
          "App"
        ],
        "summary": "This specification",
        "security": [],
        "responses": {
          "200": {
            "description": "The OpenAPI 3.0 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
