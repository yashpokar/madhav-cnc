  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "CompanyId": {
        "name": "X-Company-Id",
        "in": "header",
        "required": true,
        "description": "The company the request works in. The person must be able to open it.",
        "schema": {
          "type": "string"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Unique per intended action (8-128 chars). A retry replays the first response for 24 hours.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "UNAUTHENTICATED",
                  "ACCOUNT_DEACTIVATED",
                  "FORBIDDEN",
                  "COMPANY_REQUIRED",
                  "COMPANY_NOT_ACCESSIBLE",
                  "NOT_FOUND",
                  "VALIDATION_FAILED",
                  "CONFLICT",
                  "PRECONDITION_FAILED",
                  "IDEMPOTENCY_KEY_REUSED",
                  "RATE_LIMITED",
                  "UPGRADE_REQUIRED",
                  "INTERNAL"
                ]
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
