{
  "openapi": "3.0.3",
  "info": {
    "title": "Prodlys API",
    "version": "1",
    "description": "Mobile API. Sign in with POST /api/auth/sign-in/email and send the `set-auth-token` response header as `Authorization: Bearer <token>`. Tenant endpoints also need `X-Company-Id`. Success bodies are `{ data, meta? }`; errors are `{ error: { code, message, fields?, requestId } }`. Every response carries `X-Request-Id`."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/companies": {
      "post": {
        "tags": [
          "Onboarding"
        ],
        "summary": "Create the first company (the caller becomes its administrator)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "companyName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "industry": {
                    "type": "string",
                    "enum": [
                      "MANUFACTURING",
                      "DECORATION",
                      "PHOTO_STUDIO",
                      "SALON",
                      "HOTEL",
                      "CATERING",
                      "OTHER"
                    ]
                  },
                  "gstin": {
                    "type": "string",
                    "maxLength": 15
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "city": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "required": [
                  "companyName",
                  "industry"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "company": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "role": {
                              "type": "string",
                              "enum": [
                                "ADMIN",
                                "SALES",
                                "OPERATOR",
                                "DISPATCH",
                                "ACCOUNTANT",
                                "VIEWER"
                              ]
                            },
                            "capabilities": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "industry": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "role",
                            "capabilities",
                            "industry"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "company"
                      ],
                      "additionalProperties": false
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED: Missing, invalid or expired bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "CONFLICT: The request conflicts with the current state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "IDEMPOTENCY_KEY_REUSED: The Idempotency-Key was used for a different request; VALIDATION_FAILED: The request is invalid; see error.fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "426": {
            "description": "UPGRADE_REQUIRED: The app version is no longer supported",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: Too many requests; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL: Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
