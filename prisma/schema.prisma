enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

model Invoice {
  id String @id @default(cuid())

  companyId String         @default("") @map("company_id")
  company   CompanySetting @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    String
  status    InvoiceStatus  @default(DRAFT)

  orderId String? @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  invoiceDate DateTime  @map("invoice_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date

  placeOfSupply String? @map("place_of_supply")
  isInterState  Boolean @default(false) @map("is_inter_state")

  billingAddress String? @map("billing_address")
  customerGstin  String? @map("customer_gstin")

  discountType  DiscountType @default(NONE) @map("discount_type")
  discountValue Decimal      @default(0) @map("discount_value") @db.Decimal(12, 2)

  transportCharge         Decimal @default(0) @map("transport_charge") @db.Decimal(12, 2)
  transportTaxRatePercent Decimal @default(0) @map("transport_tax_rate_percent") @db.Decimal(5, 2)

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxableAmount  Decimal @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  cgstAmount     Decimal @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount     Decimal @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount     Decimal @default(0) @map("igst_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  roundOff       Decimal @default(0) @map("round_off") @db.Decimal(6, 2)
  total          Decimal @default(0) @db.Decimal(14, 2)

  advanceAdjusted Decimal @default(0) @map("advance_adjusted") @db.Decimal(14, 2)

  notes String?
  terms String?

  lines              InvoiceLine[]
  paymentAllocations PaymentAllocation[]
  writeOffs          InvoiceWriteOff[]
  creditDebitNotes   CreditDebitNote[]

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, number])
  @@index([status])
  @@index([customerId])
  @@index([orderId])
  @@index([invoiceDate])
  @@index([companyId])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  position Int

  itemId String? @map("item_id")
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  description String
  hsnCode     String?       @map("hsn_code")
  unit        UnitOfMeasure

  // Snapshot of what was supplied, copied from the order line so the invoice
  // still reads correctly if the item or material is renamed later.
  materialName   String?         @map("material_name")
  materialSupply MaterialSupply? @map("material_supply")
  sizeText       String?         @map("size_text")
  // Brand, shade and thickness of the item, e.g. "Greenply · Shade 12 · 18 mm".
  specText       String?         @map("spec_text")

  quantity        Decimal @db.Decimal(12, 3)
  rate            Decimal @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRatePercent  Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)

  amount     Decimal @db.Decimal(14, 2)
  cgstAmount Decimal @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount Decimal @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount Decimal @default(0) @map("igst_amount") @db.Decimal(14, 2)
  lineTotal  Decimal @map("line_total") @db.Decimal(14, 2)

  @@index([invoiceId])
  @@index([itemId])
  @@map("invoice_lines")
}

// Money on an invoice that will not be collected. It reduces what is owed (so
// the customer's balance and receivables stay honest) but is kept as its own
// record with a reason, so bad-debt history can be reviewed later, e.g. before
// taking a new order from the same customer.
enum WriteOffReason {
  CUSTOMER_UNREACHABLE
  DISPUTE
  QUALITY_ISSUE
  BUSINESS_CLOSED
  SETTLED_FOR_LESS
  LEGAL_ACTION
  OTHER
}

model InvoiceWriteOff {
  id String @id @default(cuid())

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount       Decimal        @db.Decimal(14, 2)
  reason       WriteOffReason
  notes        String?
  writtenOffOn DateTime       @map("written_off_on") @db.Date

  recordedById String? @map("recorded_by_id")
  recordedBy   User?   @relation("WriteOffRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_write_offs")
}

// A way of paying as the business names it ("HDFC NEFT", "SBI UPI", "CASH"):
// the underlying kind of payment, and the bank account it moves money through
// (none for cash). Entries remember the channel they used.
model PaymentChannel {
  id String @id @default(cuid())

  companyId String         @default("") @map("company_id")
  company   CompanySetting @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  mode      PaymentMode
  sortOrder Int            @default(0) @map("sort_order")
  isActive  Boolean        @default(true) @map("is_active")

  /// Facts the owner chooses to show with this mode: [{label, value}], such as
  /// bank name, account number, IFSC or a UPI ID. Anything can be added.
  details         Json    @default("[]")
  /// Printed on invoices and quotations as a way to pay.
  showOnDocuments Boolean @default(false) @map("show_on_documents")
  /// An optional QR code to pay with (a UPI QR, for example).
  qrStoredName    String? @map("qr_stored_name")
  qrMimeType      String? @map("qr_mime_type")

  expenses Expense[]
  payments Payment[]

  vendorPayments  VendorPayment[]
  openingBalances ChannelOpeningBalance[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, name])
  @@index([companyId])
  @@map("payment_channels")
}

model Payment {
  id String @id @default(cuid())

  companyId String         @default("") @map("company_id")
  company   CompanySetting @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    String

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  amount    Decimal         @db.Decimal(14, 2)
  mode      PaymentMode     @default(UPI)
  /// The business's own name for how it came in, e.g. HDFC NEFT (optional).
  channelId String?         @map("channel_id")
  channel   PaymentChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  /// The mode's name as it was when this was recorded, so renaming or removing
  /// a payment mode later never rewrites history.
  modeName  String?         @map("mode_name")
  reference String?
  paidOn    DateTime        @map("paid_on") @db.Date
  notes     String?

  /// Part of this receipt that settled the customer's opening balance rather
  /// than an invoice.
  openingApplied Decimal @default(0) @map("opening_applied") @db.Decimal(12, 2)

  /// Set when this receipt is the advance taken on an order. It is edited on
  /// the order and is never applied to invoices (the invoice deducts it as
  /// advanceAdjusted), so it is not counted twice.
  orderId String? @unique @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  recordedById String? @map("recorded_by_id")
  recordedBy   User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  allocations PaymentAllocation[]

  @@unique([companyId, number])
  @@index([customerId])
  @@index([paidOn])
  @@index([companyId])
  @@map("payments")
}

model PaymentAllocation {
  id String @id @default(cuid())

  paymentId String  @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

enum NoteKind {
  CREDIT
  DEBIT
}

enum NoteParty {
  CUSTOMER
  VENDOR
}

enum NoteReason {
  SALES_RETURN
  PURCHASE_RETURN
  RATE_DIFFERENCE
  DISCOUNT
  SHORT_SUPPLY
  DAMAGED_GOODS
  OTHER
}

enum NoteStatus {
  DRAFT
  ISSUED
  CANCELLED
}

model ExpenseCategory {
  id String @id @default(cuid())

  companyId String         @default("") @map("company_id")
  company   CompanySetting @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int            @default(0) @map("sort_order")
  isActive  Boolean        @default(true) @map("is_active")

  expenses Expense[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, name])
  @@index([isActive])
  @@index([companyId])
  @@map("expense_categories")
}

model Expense {
  id String @id @default(cuid())

  companyId String         @default("") @map("company_id")
  company   CompanySetting @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    String

  categoryId String?          @map("category_id")
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  expenseDate DateTime        @map("expense_date") @db.Date
  /// The vendor's name as it was when the expense was saved; vendorId is the
  /// live record (contact details), which can be missing for old entries.
  payeeName   String          @map("payee_name")
  vendorId    String?         @map("vendor_id")
  vendor      Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  channelId   String?         @map("channel_id")
  channel     PaymentChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  /// The mode's name as it was when this was recorded (see Payment.modeName).
  modeName    String?         @map("mode_name")
  description String?

  amount         Decimal @db.Decimal(14, 2)
  taxRatePercent Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)

  isInputCredit Boolean @default(false) @map("is_input_credit")
  vendorGstin   String? @map("vendor_gstin")
  billNumber    String? @map("bill_number")

  paymentMode PaymentMode @default(BANK_TRANSFER) @map("payment_mode")
  reference   String?
  notes       String?

  orderId String? @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, number])
  @@index([expenseDate])
  @@index([categoryId])
  @@index([orderId])
  @@index([companyId])
  @@map("expenses")
}

model CreditDebitNote {
  id String @id @default(cuid())

  companyId String         @default("") @map("company_id")
  company   CompanySetting @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    String
  kind      NoteKind
  status    NoteStatus     @default(DRAFT)

  partyType NoteParty  @map("party_type")
  reason    NoteReason @default(OTHER)

  customerId  String?   @map("customer_id")
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vendorName  String?   @map("vendor_name")
  vendorGstin String?   @map("vendor_gstin")

  invoiceId String?  @map("invoice_id")
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  noteDate DateTime @map("note_date") @db.Date

  placeOfSupply String? @map("place_of_supply")
  isInterState  Boolean @default(false) @map("is_inter_state")

  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  taxableAmount Decimal @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  cgstAmount    Decimal @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount    Decimal @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount    Decimal @default(0) @map("igst_amount") @db.Decimal(14, 2)
  taxAmount     Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  roundOff      Decimal @default(0) @map("round_off") @db.Decimal(6, 2)
  total         Decimal @default(0) @db.Decimal(14, 2)

  reasonNote String? @map("reason_note")

  lines CreditDebitNoteLine[]

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("NoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("NoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, number])
  @@index([kind])
  @@index([status])
  @@index([customerId])
  @@index([invoiceId])
  @@index([noteDate])
  @@index([companyId])
  @@map("credit_debit_notes")
}

model CreditDebitNoteLine {
  id     String          @id @default(cuid())
  noteId String          @map("note_id")
  note   CreditDebitNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  position Int

  description String
  hsnCode     String?       @map("hsn_code")
  unit        UnitOfMeasure

  quantity       Decimal @db.Decimal(12, 3)
  rate           Decimal @db.Decimal(12, 2)
  taxRatePercent Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)

  amount     Decimal @db.Decimal(14, 2)
  cgstAmount Decimal @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount Decimal @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount Decimal @default(0) @map("igst_amount") @db.Decimal(14, 2)
  lineTotal  Decimal @map("line_total") @db.Decimal(14, 2)

  @@index([noteId])
  @@map("credit_debit_note_lines")
}

// A readable trail of who did what to a record, shown on its page.
model ActivityLog {
  id String @id @default(cuid())

  companyId String?         @map("company_id")
  company   CompanySetting? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  entityType String @map("entity_type")
  entityId   String @map("entity_id")
  action     String
  summary    String

  userId   String? @map("user_id")
  user     User?   @relation("ActivityUser", fields: [userId], references: [id], onDelete: SetNull)
  // Kept as text so the trail still reads right if the user is removed, and so
  // customer actions on shared links can be attributed to "Customer".
  userName String? @map("user_name")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([companyId])
  @@map("activity_logs")
}

/// Someone the business pays: a supplier, a contractor, a utility. Expenses
/// point at a vendor so contact details live in one place; a vendor created
/// by typing a new name on an expense starts with just the name.
model Vendor {
  id String @id @default(cuid())

  companyId   String         @default("") @map("company_id")
  company     CompanySetting @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  contactName String?        @map("contact_name")
  phone       String?
  email       String?
  gstin       String?
  address     String?
  city        String?
  /// What they supply or why they are paid, e.g. "Edge banding, monthly".
  description String?
  isActive    Boolean        @default(true) @map("is_active")

  /// What we already owed this vendor when books were opened here.
  openingPayable Decimal   @default(0) @map("opening_payable") @db.Decimal(12, 2)
  openingAsOf    DateTime? @map("opening_as_of") @db.Date

  expenses Expense[]

  purchaseOrders PurchaseOrder[]
  purchaseBills  PurchaseBill[]
  goodsReceipts  GoodsReceipt[]
  payments       VendorPayment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([companyId])
  @@map("vendors")
}

/// Which companies a person may open. Administrators can open every company
/// without a row here.
model UserCompany {
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String         @map("company_id")
  company   CompanySetting @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, companyId])
  @@map("user_companies")
}

/// The last number issued for each kind of document, per company, so every
/// company's invoices (and the rest) run 1, 2, 3 on their own.
model DocumentCounter {
  companyId String         @map("company_id")
  company   CompanySetting @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  value     Int            @default(0)

  @@id([companyId, key])
  @@map("document_counters")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum PurchaseBillStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum StockMovementType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  ADJUSTMENT
  ISSUE
}

enum GoodsReceiptStatus {
  POSTED
  CANCELLED
}

model PurchaseOrder {
  id String @id @default(cuid())

  companyId String              @default("") @map("company_id")
  company   CompanySetting      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    String
  status    PurchaseOrderStatus @default(DRAFT)

  vendorId String @map("vendor_id")
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  orderDate    DateTime  @map("order_date") @db.Date
  expectedDate DateTime? @map("expected_date") @db.Date
  notes        String?

  lines    PurchaseOrderLine[]
  bills    PurchaseBill[]
  receipts GoodsReceipt[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, number])
  @@index([vendorId])
  @@index([status])
  @@index([companyId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id String @id @default(cuid())

  poId String        @map("po_id")
  po   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  itemId     String?   @map("item_id")
  item       Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  materialId String?   @map("material_id")
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  description    String
  qty            Decimal       @db.Decimal(14, 3)
  receivedQty    Decimal       @default(0) @map("received_qty") @db.Decimal(14, 3)
  unit           UnitOfMeasure @default(NOS)
  rate           Decimal       @db.Decimal(12, 2)
  taxRatePercent Decimal       @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  lineTotal      Decimal       @default(0) @map("line_total") @db.Decimal(14, 2)
  sortOrder      Int           @default(0) @map("sort_order")

  billLines    PurchaseBillLine[]
  receiptLines GoodsReceiptLine[]

  @@index([poId])
  @@index([itemId])
  @@index([materialId])
  @@map("purchase_order_lines")
}

model PurchaseBill {
  id String @id @default(cuid())

  companyId        String             @default("") @map("company_id")
  company          CompanySetting     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number           String
  /// The number printed on the vendor's own bill.
  vendorBillNumber String?            @map("vendor_bill_number")
  status           PurchaseBillStatus @default(DRAFT)

  vendorId String @map("vendor_id")
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  poId String?        @map("po_id")
  po   PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)

  billDate     DateTime  @map("bill_date") @db.Date
  dueDate      DateTime? @map("due_date") @db.Date
  isInterState Boolean   @default(false) @map("is_inter_state")

  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discount      Decimal @default(0) @db.Decimal(14, 2)
  taxableAmount Decimal @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  cgst          Decimal @default(0) @db.Decimal(14, 2)
  sgst          Decimal @default(0) @db.Decimal(14, 2)
  igst          Decimal @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  roundOff      Decimal @default(0) @map("round_off") @db.Decimal(6, 2)
  total         Decimal @default(0) @db.Decimal(14, 2)

  notes String?

  lines       PurchaseBillLine[]
  allocations VendorPaymentAllocation[]
  receipts    GoodsReceipt[]

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("PurchaseBillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("PurchaseBillUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, number])
  @@index([vendorId])
  @@index([status])
  @@index([billDate])
  @@index([companyId])
  @@map("purchase_bills")
}

model PurchaseBillLine {
  id String @id @default(cuid())

  billId String       @map("bill_id")
  bill   PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  poLineId String?            @map("po_line_id")
  poLine   PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)

  itemId     String?   @map("item_id")
  item       Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  materialId String?   @map("material_id")
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  description    String
  hsnCode        String?       @map("hsn_code")
  qty            Decimal       @db.Decimal(14, 3)
  unit           UnitOfMeasure @default(NOS)
  rate           Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  taxRatePercent Decimal       @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  taxable        Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  lineTotal      Decimal       @default(0) @map("line_total") @db.Decimal(14, 2)

  receiptLines GoodsReceiptLine[]

  @@index([billId])
  @@index([itemId])
  @@index([materialId])
  @@map("purchase_bill_lines")
}

model GoodsReceipt {
  id String @id @default(cuid())

  companyId String             @default("") @map("company_id")
  company   CompanySetting     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    String
  status    GoodsReceiptStatus @default(POSTED)

  vendorId String @map("vendor_id")
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  billId String?        @map("bill_id")
  bill   PurchaseBill?  @relation(fields: [billId], references: [id], onDelete: SetNull)
  poId   String?        @map("po_id")
  po     PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)

  receivedOn DateTime @map("received_on") @db.Date
  notes      String?

  lines GoodsReceiptLine[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, number])
  @@index([vendorId])
  @@index([billId])
  @@index([poId])
  @@index([companyId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id String @id @default(cuid())

  receiptId String       @map("receipt_id")
  receipt   GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  billLineId String?            @map("bill_line_id")
  billLine   PurchaseBillLine?  @relation(fields: [billLineId], references: [id], onDelete: SetNull)
  poLineId   String?            @map("po_line_id")
  poLine     PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)

  itemId     String?   @map("item_id")
  item       Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  materialId String?   @map("material_id")
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  qty      Decimal @db.Decimal(14, 3)
  unitCost Decimal @default(0) @map("unit_cost") @db.Decimal(12, 4)

  movement StockMovement?

  @@index([receiptId])
  @@map("goods_receipt_lines")
}

/// One signed change to stock of an item or a material (exactly one of the two,
/// enforced by a CHECK in the database). Stock on hand is the sum of qty.
model StockMovement {
  id String @id @default(cuid())

  companyId String         @default("") @map("company_id")
  company   CompanySetting @relation(fields: [companyId], references: [id], onDelete: Cascade)

  itemId     String?   @map("item_id")
  item       Item?     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  materialId String?   @map("material_id")
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)

  type     StockMovementType
  qty      Decimal           @db.Decimal(14, 3)
  unitCost Decimal           @default(0) @map("unit_cost") @db.Decimal(12, 4)
  date     DateTime          @db.Date

  receiptLineId String?           @unique @map("receipt_line_id")
  receiptLine   GoodsReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: SetNull)

  reference String?
  note      String?

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, itemId])
  @@index([companyId, materialId])
  @@index([date])
  @@map("stock_movements")
}

model VendorPayment {
  id String @id @default(cuid())

  companyId String         @default("") @map("company_id")
  company   CompanySetting @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    String

  vendorId String @map("vendor_id")
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  amount    Decimal         @db.Decimal(14, 2)
  mode      PaymentMode     @default(UPI)
  channelId String?         @map("channel_id")
  channel   PaymentChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  /// The mode's name as it was when this was recorded.
  modeName  String?         @map("mode_name")
  reference String?
  paidOn    DateTime        @map("paid_on") @db.Date
  notes     String?

  /// Part of this payment that settled the vendor's opening payable.
  openingApplied Decimal @default(0) @map("opening_applied") @db.Decimal(12, 2)

  recordedById String? @map("recorded_by_id")
  recordedBy   User?   @relation("VendorPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  allocations VendorPaymentAllocation[]

  @@unique([companyId, number])
  @@index([vendorId])
  @@index([paidOn])
  @@index([companyId])
  @@map("vendor_payments")
}

model VendorPaymentAllocation {
  id String @id @default(cuid())

  vendorPaymentId String        @map("vendor_payment_id")
  vendorPayment   VendorPayment @relation(fields: [vendorPaymentId], references: [id], onDelete: Cascade)

  billId String       @map("bill_id")
  bill   PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(14, 2)

  @@unique([vendorPaymentId, billId])
  @@index([billId])
  @@map("vendor_payment_allocations")
}

/// What a payment mode already held when books were opened here (can be
/// negative for an overdraft).
model ChannelOpeningBalance {
  id String @id @default(cuid())

  companyId String         @default("") @map("company_id")
  company   CompanySetting @relation(fields: [companyId], references: [id], onDelete: Cascade)

  channelId String         @map("channel_id")
  channel   PaymentChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  amount Decimal  @db.Decimal(14, 2)
  asOf   DateTime @map("as_of") @db.Date

  @@unique([companyId, channelId])
  @@index([companyId])
  @@map("channel_opening_balances")
}
