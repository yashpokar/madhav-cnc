generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SALES
  OPERATOR
  DISPATCH
  ACCOUNTANT
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?

  role          UserRole  @default(VIEWER)
  isActive      Boolean   @default(false) @map("is_active")
  phone         String?
  employeeCode  String?   @unique @map("employee_code")
  activatedAt   DateTime? @map("activated_at")
  activatedById String?   @map("activated_by_id")

  activatedBy   User?     @relation("UserActivations", fields: [activatedById], references: [id], onDelete: SetNull)
  activatedUsers User[]   @relation("UserActivations")

  sessions      Session[]
  accounts      Account[]

  partnersCreated  Partner[]  @relation("PartnerCreatedBy")
  partnersUpdated  Partner[]  @relation("PartnerUpdatedBy")
  customersCreated Customer[] @relation("CustomerCreatedBy")
  customersUpdated Customer[] @relation("CustomerUpdatedBy")
  itemsCreated     Item[]     @relation("ItemCreatedBy")
  itemsUpdated     Item[]     @relation("ItemUpdatedBy")
  materialsCreated Material[] @relation("MaterialCreatedBy")
  quotationsCreated Quotation[] @relation("QuotationCreatedBy")
  quotationsUpdated Quotation[] @relation("QuotationUpdatedBy")
  ordersCreated     Order[]     @relation("OrderCreatedBy")
  ordersUpdated     Order[]     @relation("OrderUpdatedBy")
  productionTasksAssigned  ProductionTask[] @relation("ProductionTaskAssignee")
  productionTasksCompleted ProductionTask[] @relation("ProductionTaskCompletedBy")
  attachmentsUploaded QuotationAttachment[] @relation("AttachmentUploadedBy")
  attachmentsRemoved  QuotationAttachment[] @relation("AttachmentRemovedBy")
  companySettingsUpdated CompanySetting[] @relation("CompanySettingUpdatedBy")
  sharesCreated   QuotationShare[]   @relation("ShareCreatedBy")
  commentsAuthored QuotationComment[] @relation("CommentAuthor")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  issuer                String
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")

  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([issuer, accountId])
  @@index([userId])
  @@index([providerId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

enum PartnerType {
  ARCHITECT
  CARPENTER
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ON_HOLD
}

model Partner {
  id       String      @id @default(cuid())
  code     String      @unique
  type     PartnerType
  name     String
  firmName String?     @map("firm_name")
  phone    String
  altPhone String?     @map("alt_phone")
  email    String?
  address  String?
  city     String?
  state    String?
  pincode  String?
  isActive Boolean     @default(true) @map("is_active")
  notes    String?

  preferredByArchitect Customer[] @relation("CustomerPreferredArchitect")
  preferredByCarpenter Customer[] @relation("CustomerPreferredCarpenter")
  quotationsAsArchitect Quotation[] @relation("QuotationArchitect")
  quotationsAsCarpenter Quotation[] @relation("QuotationCarpenter")
  ordersAsArchitect     Order[]     @relation("OrderArchitect")
  ordersAsCarpenter     Order[]     @relation("OrderCarpenter")

  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("PartnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation("PartnerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([isActive])
  @@index([name])
  @@index([phone])
  @@map("partners")
}

model Customer {
  id       String         @id @default(cuid())
  code     String         @unique
  name     String
  type     CustomerType   @default(INDIVIDUAL)
  status   CustomerStatus @default(ACTIVE)

  phone    String
  altPhone String?        @map("alt_phone")
  email    String?

  address  String?
  city     String?
  state    String?
  pincode  String?

  gstin    String?
  pan      String?

  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  anniversaryDate DateTime? @map("anniversary_date") @db.Date

  preferredArchitectId String?  @map("preferred_architect_id")
  preferredArchitect   Partner? @relation("CustomerPreferredArchitect", fields: [preferredArchitectId], references: [id], onDelete: SetNull)
  preferredCarpenterId String?  @map("preferred_carpenter_id")
  preferredCarpenter   Partner? @relation("CustomerPreferredCarpenter", fields: [preferredCarpenterId], references: [id], onDelete: SetNull)

  paymentTermsDays Int?    @map("payment_terms_days")
  notes            String?

  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quotations Quotation[]
  orders     Order[]

  @@index([status])
  @@index([name])
  @@index([phone])
  @@index([city])
  @@index([preferredArchitectId])
  @@index([preferredCarpenterId])
  @@map("customers")
}

enum ItemType {
  MATERIAL
  HARDWARE
  SERVICE
  FINISHED_GOOD
}

enum DimensionUnit {
  MM
  INCH
  FT
}

enum SupplyType {
  GOODS
  SERVICE
}

enum UnitOfMeasure {
  SQFT
  SQM
  RFT
  RMT
  NOS
  SHEET
  SET
  KG
  LTR
  HOUR
}

model Material {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  items Item[]

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("MaterialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("materials")
}

model Item {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  type        ItemType   @default(MATERIAL)
  supplyType  SupplyType @default(GOODS) @map("supply_type")
  isFlatRate  Boolean    @default(false) @map("is_flat_rate")

  materialId String?   @map("material_id")
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  unit UnitOfMeasure @default(NOS)

  rate         Decimal  @default(0) @db.Decimal(12, 2)
  purchaseRate Decimal? @map("purchase_rate") @db.Decimal(12, 2)

  brand String?
  shade String?

  dimensionUnit DimensionUnit @default(MM) @map("dimension_unit")
  thickness     Decimal?      @db.Decimal(10, 3)
  length        Decimal?      @db.Decimal(10, 3)
  width         Decimal?      @db.Decimal(10, 3)

  hsnCode        String? @map("hsn_code")
  taxRatePercent Decimal @default(18) @map("tax_rate_percent") @db.Decimal(5, 2)

  isActive Boolean @default(true) @map("is_active")
  notes    String?

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("ItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quotationLines QuotationLine[]
  orderLines     OrderLine[]

  @@index([type])
  @@index([materialId])
  @@index([isActive])
  @@index([name])
  @@map("items")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum MaterialSupply {
  WITH_MATERIAL
  WITHOUT_MATERIAL
}

enum DiscountType {
  NONE
  PERCENT
  AMOUNT
}

model Quotation {
  id       String          @id @default(cuid())
  number   String
  revision Int             @default(1)
  status   QuotationStatus @default(DRAFT)

  parentId String?     @map("parent_id")
  parent   Quotation?  @relation("QuotationRevisions", fields: [parentId], references: [id], onDelete: SetNull)
  revisions Quotation[] @relation("QuotationRevisions")

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  architectId String?  @map("architect_id")
  architect   Partner? @relation("QuotationArchitect", fields: [architectId], references: [id], onDelete: SetNull)
  carpenterId String?  @map("carpenter_id")
  carpenter   Partner? @relation("QuotationCarpenter", fields: [carpenterId], references: [id], onDelete: SetNull)

  subject       String?
  quotationDate DateTime  @map("quotation_date") @db.Date
  validUntil    DateTime? @map("valid_until") @db.Date

  siteAddress String? @map("site_address")
  siteCity    String? @map("site_city")
  sitePincode String? @map("site_pincode")

  discountType  DiscountType @default(NONE) @map("discount_type")
  discountValue Decimal      @default(0) @map("discount_value") @db.Decimal(12, 2)

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxableAmount  Decimal @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  roundOff       Decimal @default(0) @map("round_off") @db.Decimal(6, 2)
  total          Decimal @default(0) @db.Decimal(14, 2)

  advancePercent Decimal @default(80) @map("advance_percent") @db.Decimal(5, 2)

  notes String?
  terms String?

  lines       QuotationLine[]
  orders      Order[]
  attachments QuotationAttachment[]
  shares      QuotationShare[]
  comments    QuotationComment[]

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("QuotationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([number, revision])
  @@index([status])
  @@index([customerId])
  @@index([architectId])
  @@index([carpenterId])
  @@index([quotationDate])
  @@map("quotations")
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  position Int

  itemId String? @map("item_id")
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  description String
  unit        UnitOfMeasure

  materialSupply MaterialSupply @default(WITH_MATERIAL) @map("material_supply")
  isFlatRate     Boolean        @default(false) @map("is_flat_rate")

  dimensionUnit DimensionUnit? @map("dimension_unit")
  length        Decimal?       @db.Decimal(10, 3)
  width         Decimal?       @db.Decimal(10, 3)
  pieces        Decimal?       @db.Decimal(10, 3)

  quantity        Decimal @db.Decimal(12, 3)
  rate            Decimal @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRatePercent  Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  hsnCode         String? @map("hsn_code")

  amount    Decimal @db.Decimal(14, 2)
  taxAmount Decimal @map("tax_amount") @db.Decimal(14, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)

  notes String?

  @@index([quotationId])
  @@index([itemId])
  @@map("quotation_lines")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY
  DISPATCHED
  COMPLETED
  CANCELLED
}

model Order {
  id     String      @id @default(cuid())
  number String      @unique
  status OrderStatus @default(DRAFT)

  quotationId String?    @map("quotation_id")
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  architectId String?  @map("architect_id")
  architect   Partner? @relation("OrderArchitect", fields: [architectId], references: [id], onDelete: SetNull)
  carpenterId String?  @map("carpenter_id")
  carpenter   Partner? @relation("OrderCarpenter", fields: [carpenterId], references: [id], onDelete: SetNull)

  subject      String?
  orderDate    DateTime  @map("order_date") @db.Date
  dueDate      DateTime? @map("due_date") @db.Date
  customerPoNumber String? @map("customer_po_number")

  siteAddress String? @map("site_address")
  siteCity    String? @map("site_city")
  sitePincode String? @map("site_pincode")

  discountType  DiscountType @default(NONE) @map("discount_type")
  discountValue Decimal      @default(0) @map("discount_value") @db.Decimal(12, 2)

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxableAmount  Decimal @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  roundOff       Decimal @default(0) @map("round_off") @db.Decimal(6, 2)
  total          Decimal @default(0) @db.Decimal(14, 2)

  transportCharge        Decimal @default(0) @map("transport_charge") @db.Decimal(12, 2)
  transportTaxRatePercent Decimal @default(18) @map("transport_tax_rate_percent") @db.Decimal(5, 2)

  advanceAmount Decimal @default(0) @map("advance_amount") @db.Decimal(14, 2)

  notes String?
  terms String?

  lines           OrderLine[]
  productionTasks ProductionTask[]

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("OrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([customerId])
  @@index([quotationId])
  @@index([orderDate])
  @@index([dueDate])
  @@map("orders")
}

model OrderLine {
  id      String @id @default(cuid())
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  position Int

  itemId String? @map("item_id")
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  description String
  unit        UnitOfMeasure

  materialSupply MaterialSupply @default(WITH_MATERIAL) @map("material_supply")
  isFlatRate     Boolean        @default(false) @map("is_flat_rate")

  dimensionUnit DimensionUnit? @map("dimension_unit")
  length        Decimal?       @db.Decimal(10, 3)
  width         Decimal?       @db.Decimal(10, 3)
  pieces        Decimal?       @db.Decimal(10, 3)

  quantity        Decimal @db.Decimal(12, 3)
  rate            Decimal @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRatePercent  Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  hsnCode         String? @map("hsn_code")

  amount    Decimal @db.Decimal(14, 2)
  taxAmount Decimal @map("tax_amount") @db.Decimal(14, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)

  notes String?

  @@index([orderId])
  @@index([itemId])
  @@map("order_lines")
}

enum ProductionTaskStatus {
  PENDING
  IN_PROGRESS
  ON_HOLD
  DONE
  SKIPPED
}

model ProductionStage {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  tasks ProductionTask[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("production_stages")
}

model ProductionTask {
  id String @id @default(cuid())

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stageId String          @map("stage_id")
  stage   ProductionStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  position Int
  status   ProductionTaskStatus @default(PENDING)

  assignedToId String? @map("assigned_to_id")
  assignedTo   User?   @relation("ProductionTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  completedById String? @map("completed_by_id")
  completedBy   User?   @relation("ProductionTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orderId, stageId])
  @@index([status])
  @@index([stageId])
  @@index([assignedToId])
  @@map("production_tasks")
}

model QuotationAttachment {
  id String @id @default(cuid())

  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  fileName   String  @map("file_name")
  storedName String  @unique @map("stored_name")
  mimeType   String  @map("mime_type")
  sizeBytes  Int     @map("size_bytes")
  comment    String?

  uploadedById String? @map("uploaded_by_id")
  uploadedBy   User?   @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  removedAt   DateTime? @map("removed_at")
  removedById String?   @map("removed_by_id")
  removedBy   User?     @relation("AttachmentRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  comments QuotationComment[]

  @@index([quotationId])
  @@index([removedAt])
  @@map("quotation_attachments")
}

model CompanySetting {
  id String @id @default("default")

  companyName String  @default("Madhav CNC") @map("company_name")
  addressLine String? @map("address_line")
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  gstin       String?
  pan         String?

  bankAccountName String? @map("bank_account_name")
  bankName        String? @map("bank_name")
  bankBranch      String? @map("bank_branch")
  accountNumber   String? @map("account_number")
  ifscCode        String? @map("ifsc_code")

  logoStoredName String? @map("logo_stored_name")
  logoMimeType   String? @map("logo_mime_type")

  upiId          String? @map("upi_id")
  upiQrStoredName String? @map("upi_qr_stored_name")
  upiQrMimeType   String? @map("upi_qr_mime_type")

  defaultAdvancePercent Decimal @default(80) @map("default_advance_percent") @db.Decimal(5, 2)

  invoiceTerms String? @map("invoice_terms")

  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("CompanySettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

enum ShareDecision {
  PENDING
  ACCEPTED
  REJECTED
}

enum CommentAuthorType {
  STAFF
  CUSTOMER
}

model QuotationShare {
  id String @id @default(cuid())

  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  token     String  @unique
  isRevoked Boolean @default(false) @map("is_revoked")

  expiresAt DateTime? @map("expires_at")

  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at")

  decision           ShareDecision @default(PENDING)
  respondedAt        DateTime?     @map("responded_at")
  respondedByName    String?       @map("responded_by_name")
  responseNote       String?       @map("response_note")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ShareCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([quotationId])
  @@index([isRevoked])
  @@map("quotation_shares")
}

model QuotationComment {
  id String @id @default(cuid())

  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  attachmentId String?              @map("attachment_id")
  attachment   QuotationAttachment? @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  body       String
  authorType CommentAuthorType @map("author_type")

  authorUserId String? @map("author_user_id")
  authorUser   User?   @relation("CommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorName   String? @map("author_name")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([quotationId])
  @@index([attachmentId])
  @@map("quotation_comments")
}
